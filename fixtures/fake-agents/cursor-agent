#!/bin/sh
# Fake `cursor-agent` — the same stream-json format as claude.
. "$(dirname "$0")/_common.sh"

fake_handle_version "$@"
prompt=$(fake_last_arg "$@")
scenario=$(fake_scenario "$prompt")
reply=$(fake_reply)

fake_before_output "$scenario"

if [ "$scenario" != "silent" ]; then
  printf '{"type":"assistant","message":{"role":"assistant","content":[{"type":"text","text":"%s"}]}}\n' \
    "$(fake_json_string "$reply")"
fi

case "$scenario" in
  fail|rate_limit)
    fake_failure_stderr "$scenario"
    ;;
  *)
    printf '{"type":"result","usage":{"inputTokens":11,"outputTokens":7}}\n'
    ;;
esac

exit "$(fake_exit_code "$scenario")"
