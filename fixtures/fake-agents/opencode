#!/bin/sh
# Fake `opencode` — `run --format json`, JSONL on stdout.
. "$(dirname "$0")/_common.sh"

fake_handle_version "$@"
prompt=$(fake_last_arg "$@")
scenario=$(fake_scenario "$prompt")
reply=$(fake_reply)

fake_before_output "$scenario"

printf '{"type":"step_start","part":{"type":"step-start","snapshot":"fake"}}\n'

if [ "$scenario" != "silent" ]; then
  printf '{"type":"text","part":{"type":"text","text":"%s"}}\n' "$(fake_json_string "$reply")"
fi

case "$scenario" in
  fail|rate_limit)
    printf '{"type":"step_finish","part":{"type":"step-finish","reason":"error","error":"%s"}}\n' \
      "$(fake_json_string "fake-agent failure: $scenario")"
    fake_failure_stderr "$scenario"
    ;;
  *)
    printf '{"type":"step_finish","part":{"type":"step-finish","reason":"stop","tokens":{"input":11,"output":7,"reasoning":0}}}\n'
    ;;
esac

exit "$(fake_exit_code "$scenario")"
