#!/usr/bin/env bash
# Replace the body after the closing `---`, which is the task description or
# the agent role. The frontmatter must come back untouched.
set -euo pipefail
file="$1"
awk 'BEGIN { fences = 0 }
     /^---$/ && fences < 2 { print; fences++; next }
     fences < 2 { print; next }
     END { print ""; print "Body rewritten by the fake editor." }' "$file" > "$file.new"
mv "$file.new" "$file"
